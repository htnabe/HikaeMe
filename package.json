{
  "comments": {
    "dependencies": {
      "@algolia/client-search": "project",
      "algoliasearch": "project",
      "instantsearch.js": "project"
    },
    "devDependencies": {
      "husky": "project",
      "lint-staged": "project",
      "npm-check-updates": "project",
      "prettier": "project",
      "prettier-plugin-go-template": "project"
    }
  },
  "dependencies": {
    "@algolia/client-search": "^5.57.0",
    "@popperjs/core": "^2.11.8",
    "algoliasearch": "^5.57.0",
    "bootstrap": "^5.3.8",
    "instantsearch.js": "^4.116.0"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@htnabe/prettier-plugin-go-template": "^0.0.3",
    "@htnabe/prettier-plugin-hugo-post": "^0.0.1-rc.2",
    "@playwright/test": "^1.63.0",
    "@types/bootstrap": "^5.2.11",
    "autoprefixer": "^10.5.5",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "npm-check-updates": "^23.1.0",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "prettier": "^3.9.6",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{html,css,scss}": "prettier --write",
    "*.{js,jsx,ts,tsx}": "prettier --write"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "cd exampleSite && hugo serve --gc --watch",
    "prod": "cd exampleSite && hugo serve --gc --watch --environment production",
    "format": "prettier --write .",
    "prepare": "husky",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "update": "ncu -u && npm install --ignore-scripts"
  },
  "version": "2.0.5",
  "type": "module",
  "prettier": {
    "plugins": [
      "@htnabe/prettier-plugin-hugo-post",
      "@htnabe/prettier-plugin-go-template"
    ],
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "htmlWhitespaceSensitivity": "css",
    "overrides": [
      {
        "files": [
          "content/**/*.md",
          "**/*.md"
        ],
        "options": {
          "parser": "hugo-post"
        }
      },
      {
        "files": [
          "*.html"
        ],
        "options": {
          "parser": "go-template"
        }
      }
    ]
  }
}
