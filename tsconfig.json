{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "noEmit": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "types": ["node", "vitest/globals"]
  },
  "include": ["assets/**/*.ts", "tests/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "exampleSite"]
}
